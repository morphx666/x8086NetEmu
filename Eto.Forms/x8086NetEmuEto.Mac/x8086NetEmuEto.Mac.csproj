<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RuntimeIdentifiers Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx-x64;osx-arm64</RuntimeIdentifiers>
		<RuntimeIdentifiers Condition="!$([MSBuild]::IsOSPlatform('OSX'))">osx-x64</RuntimeIdentifiers>
		<AssemblyVersion>2026.11.27.227</AssemblyVersion>
		<FileVersion>2026.11.27.227</FileVersion>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<!-- Eto builds the .app once per runtime identifier (MacIsBuildingBundle) and merges them into a universal
		     binary. Those builds need their own obj/bin folders, or the second one reuses the first one's native
		     launcher (apphost) and lipo refuses to merge two executables of the same architecture. -->
		<AppendRuntimeIdentifierToOutputPath Condition="'$(MacIsBuildingBundle)' != 'True'">false</AppendRuntimeIdentifierToOutputPath>
		<!-- Absolute: Eto derives the "dotnet run" launcher path from it, and dotnet run resolves a relative path
		     against the current folder (e.g. the repo root) instead of the project folder -->
		<OutputPath>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'Release'))</OutputPath>
		<!-- Run on a newer .NET when .NET 10 isn't installed (release packages bundle their own runtime) -->
		<RollForward>Major</RollForward>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\x8086NetEmuEto\x8086NetEmuEto.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Eto.Platform.Mac64" Version="2.11.0" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Icon.icns">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

</Project>
